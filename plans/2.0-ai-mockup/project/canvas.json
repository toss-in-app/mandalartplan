  "notes": {
    "rowFlow": { "x": 0, "y": -300, "text": "만들기 흐름", "kind": "title1", "maxW": 3210 },
    "rowEdit": { "x": 0, "y": 1100, "text": "편집 화면에서 빈 칸 채우기", "kind": "title1", "maxW": 860 },
    "rowFail": { "x": 0, "y": 2500, "text": "AI를 쓸 수 없을 때", "kind": "title1", "maxW": 1800 },
    "nMain": { "x": 0, "y": 884, "w": 390, "maxH": 170, "text": "세부 목표가 하나도 없을 때만 보여요. 핵심 목표를 먼저 적었으면 목표 입력 화면에 그 글이 들어가 있어요." },
    "nNotice": { "x": 940, "y": 884, "w": 390, "maxH": 170, "text": "버튼을 누른 뒤 처음 한 번만 떠요. 들어오자마자 띄우지 않아요. 닫으면 광고도 만들기도 하지 않아요." },
    "nAd": { "x": 1410, "y": 884, "w": 390, "maxH": 170, "text": "토스가 띄우는 광고 화면이에요(우리가 그리지 않음). 끝까지 봐서 보상을 받았을 때만 만들어요." },
    "nMaking": { "x": 1880, "y": 884, "w": 390, "maxH": 170, "text": "세부 목표 8개를 먼저 만들고(1~3초), 실천 8묶음을 한꺼번에 채워요(3~8초)." },
    "nPreview": { "x": 2350, "y": 884, "w": 390, "maxH": 170, "text": "'이대로 시작하기'를 눌러야 판에 들어가요. 빈 칸만 채우고, 적어 둔 칸은 그대로예요." },
    "nApplied": { "x": 2820, "y": 884, "w": 390, "maxH": 170, "text": "'AI 초안' 표시는 판에 계속 남아요. 공유 이미지 맨 아래에도 'AI 초안 포함' 한 줄이 들어가요." },
    "nFillSubs": { "x": 0, "y": 2284, "w": 390, "maxH": 170, "text": "비어 있는 세부 목표만 채워요. 빈 칸이 없으면 버튼이 보이지 않아요." },
    "nFillActions": { "x": 470, "y": 2284, "w": 390, "maxH": 170, "text": "이 세부 목표의 빈 실천만 채워요. 다른 세부 목표의 실천과 겹치지 않게 만들어요." },
    "nNoAd": { "x": 0, "y": 3684, "w": 390, "maxH": 170, "text": "광고 없이는 AI를 쓰지 않아요(10-20 결정). 대신 예시로 시작하기를 권해요." },
    "nLimit": { "x": 470, "y": 3684, "w": 390, "maxH": 170, "text": "한 사람 하루 10번(10-20 결정). 서버 전체 상한(하루 3,000번)은 따로 있어요." },
    "nRefused": { "x": 940, "y": 3684, "w": 390, "maxH": 170, "text": "광고를 본 뒤 AI가 거절한 경우예요. 광고 보상은 쓰였지만 오늘 횟수에서는 빼지 않아요." },
    "nSelfHarm": { "x": 1410, "y": 3684, "w": 390, "maxH": 170, "text": "앱에서 먼저 걸러요. AI를 부르지 않고 광고도 띄우지 않아요. 시안에서는 입력한 표현을 가렸어요." }
