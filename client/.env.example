# 복사해서 .env 또는 .env.local 로. 값은 Supabase 대시보드 → Project Settings → API Keys
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 광고 그룹 ID — 콘솔 → 인앱 광고 → 광고 그룹(사업자 정보 등록 뒤 생성, 7단계). 비우면 공식 테스트 ID 를 써요.
# 라이브 ID 는 .env.production 에만 넣어요(개발·QR 테스트에서 라이브 ID 를 쓰면 정책 위반).
VITE_AD_GROUP_INTERSTITIAL_TODAY=
VITE_AD_GROUP_REWARDED_HD_IMAGE=
VITE_AD_GROUP_REWARDED_EXTRA_BOARD=
VITE_AD_GROUP_BANNER_TODAY=
