# 복사해서 .env 또는 .env.local 로. 값은 Supabase 대시보드 → Project Settings → API Keys
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# 광고 그룹 ID — 콘솔 → 인앱 광고 → 광고 그룹(약관 동의 뒤 생성, 사업자 없이도 됨). 비우면 production 이 아닌 모드(dev·vitest·build:test-ads)에서만 공식 테스트 ID 를 써요.
# 라이브 ID 는 .env.production 에만(출시 빌드 필수 — 비면 빌드 검사 실패). 출시 번들에 테스트 ID 문자열이 남으면 콘솔이 자동 반려해요(2026-10-19).
VITE_AD_GROUP_INTERSTITIAL_TODAY=
VITE_AD_GROUP_REWARDED_HD_IMAGE=
VITE_AD_GROUP_REWARDED_EXTRA_BOARD=
VITE_AD_GROUP_BANNER_TODAY=
VITE_AD_GROUP_REWARDED_AI_DRAFT=

# 알림 동의: 콘솔 → 스마트 발송 → 기능성 탭에서 만든 정기 발송 템플릿의 발송 코드(mandalartplan- 로 시작). 비우면 출시 번들에서 알림 기능을 숨겨요.
VITE_NOTIFICATION_TEMPLATE_CODE=

# 전면·리워드 광고 스위치 — 'on' 일 때만 띄워요(3.0.1 부터 off: 토스 안드로이드 광고 이벤트 누락 동안 배너만). 배너는 무관
VITE_FULL_SCREEN_ADS=off
