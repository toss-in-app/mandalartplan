{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss-in-app.github.io/mandalartplan/content.schema.json",
  "title": "mandalart content v1",
  "description": "정적 호스팅 content.json 과 번들 동봉본의 공통 스키마. 보여질 문자열만 담는다. URL·표현식·특정인 이름 금지. 같은 minClientVersion 안에서는 필드 추가만 하고, 클라는 모르는 필드를 무시한다.",
  "type": "object",
  "required": ["contentVersion", "minClientVersion", "updatedAt", "notice", "season", "templates", "cheers"],
  "properties": {
    "contentVersion": { "type": "integer", "minimum": 1, "description": "올릴 때마다 1 증가" },
    "minClientVersion": { "type": "integer", "minimum": 1, "description": "이 콘텐츠를 이해하는 최소 클라 버전. 클라 CONTENT_CLIENT_VERSION 보다 크면 원격을 버린다" },
    "updatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "notice": { "oneOf": [ { "type": "null" }, { "$ref": "#/$defs/text60" } ], "description": "홈 상단 한 줄 공지. 없으면 null" },
    "season": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "title", "from", "to", "message"],
          "properties": {
            "id": { "$ref": "#/$defs/slug" },
            "title": { "$ref": "#/$defs/text40" },
            "from": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "to": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "message": { "$ref": "#/$defs/text60" }
          }
        }
      ],
      "description": "기간 안에서만 홈에 보이는 시즌 문구"
    },
    "templates": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": { "$ref": "#/$defs/template" },
      "description": "예시 만다라트. 사용자가 '예시로 시작하기' 에서 고른다"
    },
    "cheers": {
      "type": "array", "minItems": 5, "maxItems": 50,
      "items": { "$ref": "#/$defs/text40" },
      "description": "체크인 완료 뒤 격려 문구. 날짜 기반으로 하나 고른다. 느낌표·이모지·실패 프레임 없음"
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
    "text40": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^(?!.*(https?://|intoss://|!)).*$", "description": "이모지 금지는 빌드 스크립트에서 검사(정규식 호환성 때문에 스키마엔 안 넣음)" },
    "text60": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^(?!.*(https?://|intoss://|!)).*$" },
    "actions8": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/text40" } },
    "sub": {
      "type": "object",
      "required": ["title", "actions"],
      "properties": { "title": { "$ref": "#/$defs/text40" }, "actions": { "$ref": "#/$defs/actions8" } }
    },
    "template": {
      "type": "object",
      "required": ["id", "title", "goal", "subs"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "$ref": "#/$defs/text40" },
        "goal": { "$ref": "#/$defs/text40" },
        "subs": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/sub" } }
      }
    }
  }
}
