{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss-in-app.github.io/mandalartplan/state.schema.json",
  "title": "mandalart local state v1 (Storage keys)",
  "description": "기기 로컬 Storage 에 문자열(JSON)로 저장하는 값. 개인정보 없음. 각 키는 $defs 의 하나와 일치해야 하고, 모양이 다르면 클라는 빈 값으로 취급한다.",
  "type": "object",
  "required": [
    "mandalart.boards.v1",
    "mandalart.checkins.v1",
    "mandalart.settings.v1"
  ],
  "properties": {
    "mandalart.boards.v1": {
      "$ref": "#/$defs/boards"
    },
    "mandalart.checkins.v1": {
      "$ref": "#/$defs/checkins"
    },
    "mandalart.settings.v1": {
      "$ref": "#/$defs/settings"
    }
  },
  "$defs": {
    "text40": {
      "type": "string",
      "maxLength": 40
    },
    "epochMs": {
      "type": "integer",
      "minimum": 0
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sub": {
      "type": "object",
      "required": [
        "title",
        "actions"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text40"
        },
        "actions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/text40"
          }
        }
      },
      "description": "실천의 '오늘 했어요' 는 checkins 에 날짜별로 남고, 판에는 영구 상태를 두지 않아요 (2026-09-29 done 제거)"
    },
    "board": {
      "type": "object",
      "required": [
        "id",
        "goal",
        "subs",
        "templateId",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]{13}$",
          "description": "b + 생성 시각 ms"
        },
        "goal": {
          "$ref": "#/$defs/text40"
        },
        "subs": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/sub"
          }
        },
        "templateId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "예시 템플릿에서 시작했으면 그 id"
        },
        "createdAt": {
          "$ref": "#/$defs/epochMs"
        },
        "updatedAt": {
          "$ref": "#/$defs/epochMs"
        },
        "aiDraft": {
          "$ref": "#/$defs/aiDraft"
        }
      }
    },
    "boards": {
      "type": "object",
      "required": [
        "version",
        "active",
        "boards"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "active": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "boards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/board"
          },
          "description": "두 번째 판은 settings.unlocks.extraBoard 가 true 일 때만"
        }
      }
    },
    "checkins": {
      "type": "object",
      "required": [
        "version",
        "byBoard"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "byBoard": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "days",
              "lastCompletedAt"
            ],
            "properties": {
              "days": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "additionalProperties": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "description": "그날 체크한 실천 index = 세부목표 index × 8 + 실천 index. 빈 배열 = 완료했지만 0개(쉰 날)"
                },
                "description": "최근 400일만 보관"
              },
              "lastCompletedAt": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/epochMs"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "version",
        "notification",
        "unlocks",
        "seenContentVersion",
        "firstCheckinAt",
        "backup",
        "ads"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "notification": {
          "enum": [
            "unknown",
            "agreed",
            "declined"
          ]
        },
        "unlocks": {
          "type": "object",
          "required": [
            "extraBoard"
          ],
          "properties": {
            "extraBoard": {
              "type": "boolean"
            }
          }
        },
        "seenContentVersion": {
          "type": "integer",
          "minimum": 0
        },
        "firstCheckinAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/epochMs"
            }
          ]
        },
        "backup": {
          "type": "object",
          "required": [
            "enabled",
            "key",
            "lastBackupAt"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "설정에서 '백업 켜기' 를 누른 뒤 true. 끄면 서버 본도 지움"
            },
            "key": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^k[0-9a-f]{64}$"
                }
              ],
              "description": "sha256('mandalartplan:' + 토스 익명 키). 켤 때 한 번 계산해 저장"
            },
            "lastBackupAt": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/epochMs"
                }
              ]
            }
          },
          "description": "2026-10-04 추가 (Supabase 백업·복원)"
        },
        "ads": {
          "type": "object",
          "required": [
            "lastInterstitialDate"
          ],
          "properties": {
            "lastInterstitialDate": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/date"
                }
              ],
              "description": "전면 광고를 마지막으로 보여준 날(하루 1회 상한)"
            }
          },
          "description": "2026-10-06 추가 (기능 5 광고). 없으면 기본값"
        },
        "ai": {
          "type": "object",
          "required": [
            "noticeAt",
            "runs"
          ],
          "properties": {
            "noticeAt": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/epochMs"
                }
              ],
              "description": "생성형 AI 사전 고지 시트에서 '확인'을 누른 시각. null 이면 다음 AI 실행 때 먼저 고지"
            },
            "runs": {
              "type": "object",
              "required": [
                "date",
                "count"
              ],
              "properties": {
                "date": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/date"
                    }
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "date(기기 날짜)에 AI 를 성공적으로 돌린 횟수. 하루 10회 상한"
                }
              }
            }
          },
          "description": "2.0 추가(2026-10-20, AI 초안). 없으면 기본값 { noticeAt: null, runs: { date: null, count: 0 } }"
        }
      }
    },
    "aiDraft": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "at",
            "model",
            "promptVersion"
          ],
          "properties": {
            "at": {
              "$ref": "#/$defs/epochMs",
              "description": "AI 결과를 판에 마지막으로 넣은 시각"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "예: claude-haiku-5-5"
            },
            "promptVersion": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ],
      "description": "2.0 추가(2026-10-20). AI 초안·빈 칸 채우기 결과를 이 판에 넣었으면 기록, 아니면 null 또는 없음. 있으면 홈·전체 보기·공유 이미지에 'AI 초안' 표시(서비스 오픈 정책 2-4)"
    }
  }
}
