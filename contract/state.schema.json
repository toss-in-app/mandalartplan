{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss-in-app.github.io/mandalartplan/state.schema.json",
  "title": "mandalart local state v1 (Storage keys)",
  "description": "기기 로컬 Storage 에 문자열(JSON)로 저장하는 값. 개인정보 없음. 각 키는 $defs 의 하나와 일치해야 하고, 모양이 다르면 클라는 빈 값으로 취급한다.",
  "type": "object",
  "required": [
    "mandalart.boards.v1",
    "mandalart.checkins.v1",
    "mandalart.settings.v1"
  ],
  "properties": {
    "mandalart.boards.v1": {
      "$ref": "#/$defs/boards"
    },
    "mandalart.checkins.v1": {
      "$ref": "#/$defs/checkins"
    },
    "mandalart.settings.v1": {
      "$ref": "#/$defs/settings"
    }
  },
  "$defs": {
    "text40": {
      "type": "string",
      "maxLength": 40
    },
    "epochMs": {
      "type": "integer",
      "minimum": 0
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sub": {
      "type": "object",
      "required": [
        "title",
        "actions"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/text40"
        },
        "actions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/text40"
          }
        }
      },
      "description": "실천의 '오늘 했어요' 는 checkins 에 날짜별로 남고, 판에는 영구 상태를 두지 않아요 (2026-09-29 done 제거)"
    },
    "board": {
      "type": "object",
      "required": [
        "id",
        "goal",
        "subs",
        "templateId",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^b[0-9]{13}$",
          "description": "b + 생성 시각 ms"
        },
        "goal": {
          "$ref": "#/$defs/text40"
        },
        "subs": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/sub"
          }
        },
        "templateId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ],
          "description": "예시 템플릿에서 시작했으면 그 id"
        },
        "createdAt": {
          "$ref": "#/$defs/epochMs"
        },
        "updatedAt": {
          "$ref": "#/$defs/epochMs"
        }
      }
    },
    "boards": {
      "type": "object",
      "required": [
        "version",
        "active",
        "boards"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "active": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "boards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/board"
          },
          "description": "두 번째 판은 settings.unlocks.extraBoard 가 true 일 때만"
        }
      }
    },
    "checkins": {
      "type": "object",
      "required": [
        "version",
        "byBoard"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "byBoard": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "days",
              "lastCompletedAt"
            ],
            "properties": {
              "days": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "additionalProperties": {
                  "type": "array",
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 63
                  },
                  "description": "그날 체크한 실천 index = 세부목표 index × 8 + 실천 index. 빈 배열 = 완료했지만 0개(쉰 날)"
                },
                "description": "최근 400일만 보관"
              },
              "lastCompletedAt": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/epochMs"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "version",
        "notification",
        "unlocks",
        "seenContentVersion",
        "firstCheckinAt"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "notification": {
          "enum": [
            "unknown",
            "agreed",
            "declined"
          ]
        },
        "unlocks": {
          "type": "object",
          "required": [
            "extraBoard"
          ],
          "properties": {
            "extraBoard": {
              "type": "boolean"
            }
          }
        },
        "seenContentVersion": {
          "type": "integer",
          "minimum": 0
        },
        "firstCheckinAt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/epochMs"
            }
          ]
        }
      }
    }
  }
}
